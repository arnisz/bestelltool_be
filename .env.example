# Development environment
APP_ENV=dev
AUTH_STATIC_TOKENS=dev-token-dispatcher:dispatcher-1:dispatcher,dev-token-technician:technician-1:technician,dev-token-admin:admin-1:admin

# Main development database (docker-compose service: db)
POSTGRES_USER=resource_admin
POSTGRES_PASSWORD=change_me
POSTGRES_DB=resource_dev

# Optional test database (docker-compose profile: test, service: db-test)
POSTGRES_TEST_USER=resource_test
POSTGRES_TEST_PASSWORD=resource_test
POSTGRES_TEST_DB=resource_test

# HTTP server settings
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

# Integration test target for local db-test profile
TEST_DATABASE_URL=postgres://resource_test:resource_test@127.0.0.1:5433/resource_test?sslmode=disable

ENCRYPTION_KEY=QBtEaqxS7YDcT4gbePXr+hU8njwrk+IwM8R0SnxutE4=
# .env.example
PRINCIPAL_CACHE_TTL=30s